generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  male
  female
  other
}

enum UserRole {
  user
  admin
}

enum PageContentType {
  text
  rich_text
  html
}

enum PaymentTransactionStatus {
  pending
  completed
  failed
  refunded
  cancelled
}

enum UserSubscriptionStatus {
  active
  expired
  cancelled
}

enum TradingDirection {
  buy
  sell
}

enum TradingAlertType {
  Swing
  Scalp
}

enum TradingAlertStatus {
  completed
  open
  stopped
}

model User {
  id            BigInt               @id @default(autoincrement()) @db.BigInt
  first_name    String               @db.VarChar(255)
  last_name     String               @db.VarChar(255)
  email         String               @unique @db.VarChar(255)
  password      String?              @db.VarChar(255)
  gender        Gender?
  google_id     String?              @unique @db.VarChar(255)
  facebook_id   String?              @unique @db.VarChar(255)
  apple_id      String?              @unique @db.VarChar(255)
  role          UserRole             @default(user)
  phone         String?              @db.VarChar(20)
  image         String?              @db.Text
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  subscriptions UserSubscription[]
  transactions  PaymentTransaction[]
  table_rows    TableRow[]
  table_cells   TableCell[]
  preferences   UserPreference[]

  @@map("users")
}

model UserPreference {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  user_id    BigInt   @db.BigInt
  key        String   @db.VarChar(255)
  value      String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, key])
  @@index([user_id])
  @@map("user_preferences")
}

model SubscriptionPackage {
  id                   BigInt                           @id @default(autoincrement()) @db.BigInt
  price                Decimal                          @db.Decimal(8, 2)
  duration_hours       Int
  free_trial_hours     Int?
  additional_discounts Json?
  campaigns            Json?
  publish              Boolean                          @default(false)
  created_at           DateTime                         @default(now())
  updated_at           DateTime                         @updatedAt
  translations         SubscriptionPackageTranslation[]
  subscriptions        UserSubscription[]
  payment_transactions PaymentTransaction[]

  @@map("subscription_packages")
}

model SubscriptionPackageTranslation {
  id                      BigInt              @id @default(autoincrement()) @db.BigInt
  subscription_package_id BigInt              @db.BigInt
  locale                  String              @db.VarChar(5)
  name                    String              @db.VarChar(255)
  detail                  String              @db.Text
  created_at              DateTime            @default(now())
  updated_at              DateTime            @updatedAt
  package                 SubscriptionPackage @relation(fields: [subscription_package_id], references: [id], onDelete: Cascade)

  @@unique([subscription_package_id, locale], map: "unique_subscription_package_locale")
  @@map("subscription_package_translations")
}

model Education {
  id           BigInt                 @id @default(autoincrement()) @db.BigInt
  slug         String                 @db.VarChar(255)
  publish      Boolean                @default(false)
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt
  translations EducationTranslation[]

  @@map("educations")
}

model EducationTranslation {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  education_id BigInt    @db.BigInt
  locale       String    @db.VarChar(255)
  title        String    @db.VarChar(255)
  content      String    @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  education    Education @relation(fields: [education_id], references: [id], onDelete: Cascade)

  @@unique([education_id, locale], map: "unique_educations_locale")
  @@map("education_translations")
}

model PageContent {
  id              BigInt                   @id @default(autoincrement()) @db.BigInt
  page_identifier String                   @db.VarChar(255)
  section_key     String                   @db.VarChar(255)
  content_type    PageContentType          @default(text)
  display_order   Int                      @default(0)
  is_active       Boolean                  @default(true)
  created_at      DateTime                 @default(now())
  updated_at      DateTime                 @updatedAt
  translations    PageContentTranslation[]

  @@unique([page_identifier, section_key])
  @@index([page_identifier])
  @@index([section_key])
  @@map("page_contents")
}

model PageContentTranslation {
  id              BigInt      @id @default(autoincrement()) @db.BigInt
  page_content_id BigInt      @db.BigInt
  locale          String      @db.VarChar(255)
  content_value   String      @db.Text
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  page_content    PageContent @relation(fields: [page_content_id], references: [id], onDelete: Cascade)

  @@unique([page_content_id, locale], map: "unique_page_content_locale")
  @@map("page_content_translations")
}

model PaymentGateway {
  id            BigInt               @id @default(autoincrement()) @db.BigInt
  name          String               @unique @db.VarChar(255)
  display_name  String               @db.VarChar(255)
  description   String?              @db.Text
  is_active     Boolean              @default(false)
  credentials   Json?
  settings      Json?
  display_order Int                  @default(0)
  icon          String?              @db.VarChar(255)
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  transactions  PaymentTransaction[]

  @@index([is_active])
  @@map("payment_gateways")
}

model PaymentTransaction {
  id                 BigInt                   @id @default(autoincrement()) @db.BigInt
  user_id            BigInt                   @db.BigInt
  package_id         BigInt                   @db.BigInt
  payment_gateway_id BigInt                   @db.BigInt
  transaction_id     String                   @unique @db.VarChar(255)
  amount             Decimal                  @db.Decimal(10, 2)
  currency           String                   @default("USD") @db.VarChar(3)
  status             PaymentTransactionStatus @default(pending)
  gateway_response   Json?
  failure_reason     String?                  @db.Text
  completed_at       DateTime?
  created_at         DateTime                 @default(now())
  updated_at         DateTime                 @updatedAt
  user               User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package            SubscriptionPackage      @relation(fields: [package_id], references: [id], onDelete: Cascade)
  gateway            PaymentGateway           @relation(fields: [payment_gateway_id], references: [id], onDelete: Cascade)
  subscriptions      UserSubscription[]

  @@index([user_id])
  @@index([package_id])
  @@index([payment_gateway_id])
  @@index([status])
  @@index([transaction_id])
  @@map("payment_transactions")
}

model UserSubscription {
  id                     BigInt                 @id @default(autoincrement()) @db.BigInt
  user_id                BigInt                 @db.BigInt
  package_id             BigInt                 @db.BigInt
  payment_transaction_id BigInt?                @db.BigInt
  start_date             DateTime
  end_date               DateTime
  status                 UserSubscriptionStatus @default(active)
  cancelled_at           DateTime?
  cancellation_reason    String?                @db.Text
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package                SubscriptionPackage    @relation(fields: [package_id], references: [id], onDelete: Cascade)
  transaction            PaymentTransaction?    @relation(fields: [payment_transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([package_id])
  @@index([status])
  @@index([user_id, status])
  @@index([end_date])
  @@map("user_subscriptions")
}

model CurrencyPair {
  id                BigInt            @id @default(autoincrement()) @db.BigInt
  code              String            @unique @db.VarChar(10)
  base_currency     String            @db.VarChar(3)
  quote_currency    String            @db.VarChar(3)
  is_active         Boolean           @default(true)
  display_order     Int               @default(0)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  table_rows        TableRow[]
  score_dashboard   ScoreDashboard[]
  fx_analyzer_cache FxAnalyzerCache[]

  @@map("currency_pairs")
}

model DynamicTable {
  id             BigInt        @id @default(autoincrement()) @db.BigInt
  name           String        @db.VarChar(255)
  identifier     String        @unique @db.VarChar(255)
  description    String?       @db.Text
  table_metadata Json?
  is_active      Boolean       @default(true)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  rows           TableRow[]
  columns        TableColumn[]

  @@map("dynamic_tables")
}

model TableRow {
  id               BigInt        @id @default(autoincrement()) @db.BigInt
  dynamic_table_id BigInt        @db.BigInt
  currency_pair_id BigInt?       @db.BigInt
  row_index        Int
  user_id          BigInt?       @db.BigInt
  row_metadata     Json?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  table            DynamicTable  @relation(fields: [dynamic_table_id], references: [id], onDelete: Cascade)
  currencyPair     CurrencyPair? @relation(fields: [currency_pair_id], references: [id], onDelete: SetNull)
  user             User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cells            TableCell[]

  @@unique([dynamic_table_id, row_index, user_id])
  @@index([dynamic_table_id, row_index])
  @@index([user_id])
  @@map("table_rows")
}

model TableColumn {
  id               BigInt       @id @default(autoincrement()) @db.BigInt
  dynamic_table_id BigInt       @db.BigInt
  header           String       @db.VarChar(255)
  key              String?      @db.VarChar(255)
  column_index     Int
  column_metadata  Json?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  table            DynamicTable @relation(fields: [dynamic_table_id], references: [id], onDelete: Cascade)
  cells            TableCell[]

  @@unique([dynamic_table_id, column_index])
  @@index([dynamic_table_id, column_index])
  @@map("table_columns")
}

model TableCell {
  id              BigInt      @id @default(autoincrement()) @db.BigInt
  table_row_id    BigInt      @db.BigInt
  table_column_id BigInt      @db.BigInt
  user_id         BigInt?     @db.BigInt
  value           String?     @db.Text
  formula         String?     @db.Text
  data_type       String      @default("text") @db.VarChar(255)
  cell_metadata   Json?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  row             TableRow    @relation(fields: [table_row_id], references: [id], onDelete: Cascade)
  column          TableColumn @relation(fields: [table_column_id], references: [id], onDelete: Cascade)
  user            User?       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([table_row_id, table_column_id, user_id])
  @@index([table_row_id, table_column_id])
  @@index([user_id])
  @@map("table_cells")
}

model TradingAlert {
  id              BigInt             @id @default(autoincrement()) @db.BigInt
  trade_id        String?            @unique @db.VarChar(255)
  pair            String?            @db.VarChar(255)
  direction       TradingDirection?
  entry_level     Decimal?           @db.Decimal(10, 5)
  stop_loss       Decimal?           @db.Decimal(10, 5)
  tp1             Decimal?           @db.Decimal(10, 5)
  tp2             Decimal?           @db.Decimal(10, 5)
  tp3             Decimal?           @db.Decimal(10, 5)
  image_path      String?            @db.VarChar(255)
  trade_follow_up String?            @db.Text
  type            String?            @db.VarChar(20)
  direction_type  String?            @db.VarChar(20)
  session         String?            @db.VarChar(20)
  risk            String?            @db.VarChar(20)
  exit_price      Decimal?           @db.Decimal(10, 5)
  outcome         String?            @db.VarChar(20)
  pips            Decimal?           @db.Decimal(10, 2)
  close_reason    String?            @db.VarChar(40)
  tsl_enabled     Boolean            @default(false)
  breakeven_enabled Boolean          @default(false)
  activated       Boolean            @default(true)
  activation_side String?            @db.VarChar(8)
  max_tp_hit      Int                @default(0)
  breakeven_done  Boolean            @default(false)
  tsl_active      Boolean            @default(false)
  last_tsl_sl     Decimal?           @db.Decimal(10, 5)
  last_alert_event String?           @db.VarChar(20)
  accumulated_pips Decimal           @default(0) @db.Decimal(10, 2)
  manual_partial_closed Boolean       @default(false)
  result          Decimal            @default(0) @db.Decimal(10, 2)
  status          TradingAlertStatus @default(open)
  comment         String?            @db.Text
  date            DateTime?          @db.Date
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  partial_closes  TradePartialClose[]

  @@index([date])
  @@index([status])
  @@index([pair])
  @@map("trading_alerts")
}

model TradePartialClose {
  id               BigInt       @id @default(autoincrement()) @db.BigInt
  trading_alert_id BigInt       @db.BigInt
  tp_level         Int
  pips             Decimal      @db.Decimal(10, 2)
  exit_price       Decimal?     @db.Decimal(10, 5)
  outcome          String?      @db.VarChar(20)
  close_reason     String?      @db.VarChar(80)
  created_at       DateTime     @default(now())
  trading_alert    TradingAlert @relation(fields: [trading_alert_id], references: [id], onDelete: Cascade)

  @@index([trading_alert_id])
  @@index([created_at])
  @@map("trade_partial_closes")
}

model ColorConfiguration {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  type          String   @db.VarChar(255)
  name          String   @db.VarChar(255)
  min_value     Float
  max_value     Float
  color         String   @db.VarChar(255)
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([type, is_active])
  @@map("color_configurations")
}

model RiskModeScore {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  score      Decimal  @default(0) @db.Decimal(8, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("risk_mode_scores")
}

model ScoreDashboard {
  id                BigInt       @id @default(autoincrement()) @db.BigInt
  currency_pair_id  BigInt       @unique @db.BigInt
  net_score         Decimal?     @db.Decimal(10, 2)
  net_bias          String?      @db.VarChar(255)
  trend_score       Decimal?     @db.Decimal(10, 2)
  momentum_score    Decimal?     @db.Decimal(10, 2)
  volatility_score  Decimal?     @db.Decimal(10, 2)
  sentiment_score   Decimal?     @db.Decimal(10, 2)
  seasonal_score    Decimal?     @db.Decimal(10, 2)
  cot_score         Decimal?     @db.Decimal(10, 2)
  fundamental_score Decimal?     @db.Decimal(10, 2)
  additional_scores Json?
  calculated_at     DateTime?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  currencyPair      CurrencyPair @relation(fields: [currency_pair_id], references: [id], onDelete: Cascade)

  @@index([currency_pair_id])
  @@map("score_dashboard")
}

model AppConfig {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  key         String   @unique @db.VarChar(255)
  value       String?  @db.Text
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([key])
  @@map("app_configs")
}

model TradeAlertPair {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  name          String   @unique @db.VarChar(50)
  scalping_sl   Int?
  swing_sl      Int?
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("trade_alert_pairs")
}

model FxAnalyzerCache {
  id               BigInt        @id @default(autoincrement()) @db.BigInt
  pair             String        @unique @db.VarChar(255)
  currency_pair_id BigInt?       @db.BigInt
  complete_data    String        @db.Text
  last_updated     DateTime      @default(now())
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  currencyPair     CurrencyPair? @relation(fields: [currency_pair_id], references: [id], onDelete: Cascade)

  @@index([currency_pair_id])
  @@index([last_updated])
  @@map("fx_analyzer_cache")
}

model ForumRule {
  id           Int                     @id @default(autoincrement())
  active       Boolean                 @default(true)
  created_at   DateTime                @default(now())
  updated_at   DateTime                @updatedAt
  translations ForumRulesTranslation[]

  @@map("forum_rules")
}

model ForumRulesTranslation {
  id             Int       @id @default(autoincrement())
  locale         locales
  title          String    @db.VarChar(255)
  description    String    @db.Text
  tags           Json?
  forumRules     ForumRule @relation(fields: [forum_rules_id], references: [id], onDelete: Cascade)
  forum_rules_id Int
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@unique([title, description, forum_rules_id, locale], map: "unique_forum_rules_id_locale")
  @@map("forum_rules_translations")
}

model ForumAnnouncement {
  id              Int                           @id @default(autoincrement())
  active          Boolean                       @default(true)
  created_at      DateTime                      @default(now())
  updated_at      DateTime                      @updatedAt
  translations    ForumAnnouncementsTranslation[]

  @@map("forum_announcements")
}

model ForumAnnouncementsTranslation {
  id                    Int       @id @default(autoincrement())
  locale                locales
  title                 String    @db.VarChar(255)
  description           String    @db.Text
  tags                  Json?
  forumAnnouncements    ForumAnnouncement @relation(fields: [forum_announcements_id], references: [id], onDelete: Cascade)
  forum_announcements_id Int
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@unique([title, description, forum_announcements_id, locale], map: "unique_forum_announcements_id_locale")
  @@map("forum_announcements_translations")
}

model ForumPost {
  id          Int              @id @default(autoincrement())
  active      Boolean          @default(true)
  category    String           @db.VarChar(50)
  author_name String           @default("Forum Team") @db.VarChar(255)
  title       String           @db.VarChar(255)
  content     String           @db.Text
  image_path  String?          @db.Text
  view_count  Int              @default(0)
  tags        Json?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  replies     ForumPostReply[]

  @@index([category])
  @@map("forum_posts")
}

model ForumPostReply {
  id           Int       @id @default(autoincrement())
  forum_post_id Int
  author_name  String    @default("Forum Team") @db.VarChar(255)
  message      String    @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  post         ForumPost @relation(fields: [forum_post_id], references: [id], onDelete: Cascade)

  @@index([forum_post_id])
  @@map("forum_post_replies")
}

enum VisitorGeoStatus {
  pending
  resolved
  failed
}

model VisitorGeo {
  id            BigInt           @id @default(autoincrement()) @db.BigInt
  ip_address    String           @unique @db.VarChar(45)
  country_code  String?          @db.VarChar(8)
  country_name  String?          @db.VarChar(255)
  region_name   String?          @db.VarChar(255)
  status        VisitorGeoStatus @default(pending)
  last_error    String?          @db.VarChar(500)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  @@map("visitor_geo")
}

enum locales {
  en
  ru
  de
  fr
  zh
}

/// One classified FinancialJuice headline for the Market Driver Board.
/// `day_key` is the Asia/Dubai (UAE) 01:00-to-01:00 market day used for the live pool + reset;
/// past days stay in the table and become the source for the Historical Analysis page.
model MarketDriverNews {
  id             String   @id @default(cuid())
  /// RSS guid/link (or deterministic fallback fingerprint).
  guid           String   @db.VarChar(500)
  /// Stable feed/source identity. A GUID is only unique within a source.
  source_id      String   @default("unknown") @db.VarChar(80)
  /// SHA-256(source_id + stable source identifier). New writes always populate this.
  source_key     String?  @unique @db.VarChar(800)
  /// SHA-256 of source content used to decide whether an explicit reprocess is needed.
  content_hash   String?  @db.Char(64)
  /// Normalized headline used for soft/semantic dedup within a day.
  normalized     String   @db.VarChar(500)
  day_key        String   @db.VarChar(10)
  headline       String   @db.VarChar(1000)
  source         String?  @db.VarChar(255)
  /// ECONOMIC | DRIVER | GEOPOLITICAL | IRRELEVANT
  category       String   @db.VarChar(20)
  /// High | Medium | Low
  impact         String   @db.VarChar(10)
  summary        String?  @db.VarChar(500)
  /// [{ asset, bias, score }] — tracked assets this headline affects.
  assets         Json
  /// Semantic cause family used for deterministic scoring aggregation; not an event duplicate id.
  driver_theme   String?  @db.VarChar(120)
  causal_theme_id String? @db.VarChar(160)
  /// Stable scheduled-release family key used to avoid calendar + RSS macro double counting.
  macro_event_key String? @db.VarChar(80)
  /// ESCALATION | DE_ESCALATION | WATCH | IRRELEVANT; determined before asset transmission.
  geo_state      String?  @db.VarChar(20)
  geo_components Json?
  semantic_direction String? @db.VarChar(12)
  semantic_strength String? @db.VarChar(12)
  /// Direct provider signals and code-derived/transmitted signals remain separately auditable.
  direct_asset_signals Json?
  transmitted_asset_signals Json?
  sign_validation_status String? @default("NOT_APPLICABLE") @db.VarChar(20)
  /// AI Analyst semantic provenance. Historical rows remain nullable and are never rewritten.
  fundamental_cause String? @db.VarChar(500)
  event_relation String? @db.VarChar(20)
  event_duplicate_of String? @db.VarChar(50)
  /// Contract-level causal state retained on the raw row for audit/replay.
  event_type String? @db.VarChar(40)
  observed_market_reaction String? @db.VarChar(500)
  event_strength String? @db.VarChar(20)
  event_severity Float?
  event_credibility Float?
  event_freshness Float?
  event_persistence Float?
  transmission_reason String? @db.VarChar(1000)
  counter_evidence Json?
  current_asset_contributions Json?
  supporting_guid_ids Json?
  confirmation_only Boolean @default(false)
  macro_actual String? @db.VarChar(120)
  macro_forecast String? @db.VarChar(120)
  macro_previous String? @db.VarChar(120)
  /// Code-generated canonical event identity. This is narrower than a causal theme.
  canonical_event_id String? @db.VarChar(140)
  /// Code-generated canonical causal-theme identity used for theme-level scoring.
  canonical_theme_id String? @db.VarChar(140)
  causal_theme_summary String? @db.VarChar(500)
  theme_action String? @db.VarChar(24)
  catalyst_eligible Boolean?
  confidence Float?
  needs_review Boolean @default(false)
  decision_source String? @db.VarChar(24)
  prompt_version String? @db.VarChar(80)
  semantic_decided_at DateTime?
  macro_eligible Boolean?
  macro_family String? @db.VarChar(120)
  macro_direction_summary String? @db.VarChar(500)
  macro_asset_scores Json?
  decision_reason String? @db.VarChar(1000)
  structural_validation_status String? @db.VarChar(20)
  /// Set when this item was folded into an earlier one (soft dedup); such rows don't score.
  duplicate_of   String?  @db.VarChar(50)
  /// Once a row is shown on the News Headline board it is LOCKED for the rest of the UAE market
  /// day: this flag only ever flips false→true. Board display = locked rows; no later pass
  /// (dedup, re-sanitize, re-key, heal) may un-show a locked row. Admission decisions happen
  /// before locking; after locking a row is frozen for visibility. Doc §34 stability requirement.
  board_locked   Boolean  @default(false)
  /// Durable processing checkpoints. Existing rows are backfilled as complete by migration.
  classification_completed Boolean @default(true)
  semantic_dedup_completed Boolean @default(true)
  semantic_dedup_started_at DateTime?
  semantic_dedup_worker_id String? @db.VarChar(120)
  coverage_repair_completed Boolean @default(true)
  /// Stable, human-readable final processing decision for admin auditability.
  final_decision_code String? @db.VarChar(60)
  final_decision_reason String? @db.VarChar(1000)
  secondary_reasons Json?
  decision_ingest_id String? @db.VarChar(100)
  classification_job_id String? @db.VarChar(50)
  classification_provider String? @db.VarChar(30)
  classification_model String? @db.VarChar(120)
  published_at   DateTime?
  created_at     DateTime @default(now())

  @@index([day_key])
  @@index([category])
  @@index([guid])
  @@index([source_id])
  @@index([semantic_dedup_completed, semantic_dedup_started_at], map: "market_driver_news_semantic_dedup_recovery_idx")
  @@unique([source_id, guid], map: "market_driver_news_source_id_guid_key")
  @@index([day_key, board_locked])
  @@index([day_key, final_decision_code])
  @@index([causal_theme_id])
  @@index([macro_event_key])
  @@index([geo_state])
  @@index([event_relation])
  @@index([canonical_event_id])
  @@index([canonical_theme_id])
  @@index([causal_theme_id, catalyst_eligible])
  @@index([needs_review, classification_completed])
  canonicalEvent MarketDriverCanonicalEvent? @relation("MarketDriverNewsCanonicalEvent", fields: [canonical_event_id], references: [id], onDelete: SetNull)
  canonicalTheme MarketDriverCanonicalTheme? @relation("MarketDriverNewsCanonicalTheme", fields: [canonical_theme_id], references: [id], onDelete: SetNull)
  @@map("market_driver_news")
}

/// Durable event registry. Different headlines can refer to the same event/update while
/// retaining every raw MarketDriverNews row for audit/history.
model MarketDriverCanonicalEvent {
  id                      String   @id @db.VarChar(140)
  day_key                 String   @db.VarChar(10)
  source_id               String   @db.VarChar(80)
  source_guid             String   @db.VarChar(500)
  normalized_signature    String   @db.Char(64)
  headline                String   @db.VarChar(1000)
  relation                String   @default("NEW_EVENT") @db.VarChar(20)
  status                  String   @default("ACTIVE") @db.VarChar(20)
  canonical_theme_id      String?  @db.VarChar(140)
  event_type              String?  @db.VarChar(40)
  fundamental_cause       String?  @db.VarChar(500)
  observed_market_reaction String? @db.VarChar(500)
  event_strength          String?  @db.VarChar(20)
  severity                Float?
  credibility             Float?
  freshness               Float?
  persistence             Float?
  geo_state               String?  @db.VarChar(20)
  transmission_reason     String?  @db.VarChar(1000)
  affected_assets         Json?
  current_asset_contributions Json?
  counter_evidence       Json?
  supporting_guid_ids    Json?
  confirmation_guid_ids  Json?
  update_history         Json?
  catalyst_eligible      Boolean  @default(true)
  independent            Boolean  @default(true)
  valid                  Boolean  @default(true)
  provider               String?  @db.VarChar(30)
  model                  String?  @db.VarChar(120)
  prompt_version         String?  @db.VarChar(80)
  decision_at            DateTime?
  first_seen_at           DateTime @default(now())
  last_seen_at            DateTime @default(now())
  supporting_headline_ids Json?
  metadata                Json?
  headlines               MarketDriverNews[] @relation("MarketDriverNewsCanonicalEvent")

  @@unique([source_id, source_guid], map: "market_driver_canonical_event_source_guid_key")
  @@index([day_key, status])
  @@index([canonical_theme_id])
  @@index([day_key, status, valid, independent], map: "market_driver_canonical_events_active_arithmetic_idx")
  @@index([day_key, event_type])
  @@map("market_driver_canonical_events")
}

/// Current state of one code-generated causal driver cluster. Numeric Catalyst aggregation reads
/// this table once per theme; it never sums headline rows.
model MarketDriverCanonicalTheme {
  id                      String   @id @db.VarChar(140)
  day_key                 String   @db.VarChar(10)
  theme_key               String   @db.VarChar(180)
  label                   String   @db.VarChar(180)
  summary                 String   @db.VarChar(1000)
  theme_type              String   @default("DRIVER") @db.VarChar(30)
  status                  String   @default("ACTIVE") @db.VarChar(20)
  geo_state               String?  @db.VarChar(20)
  direct_evidence         Json?
  asset_contributions     Json
  confidence              Float    @default(0)
  first_seen_at           DateTime @default(now())
  last_updated_at         DateTime @default(now())
  latest_version          Int      @default(1)
  supporting_event_ids    Json?
  supporting_headline_ids Json?
  headlines               MarketDriverNews[] @relation("MarketDriverNewsCanonicalTheme")
  revisions               MarketDriverCanonicalThemeRevision[]

  @@unique([day_key, theme_key, theme_type], map: "market_driver_canonical_theme_key")
  @@index([day_key, status])
  @@index([day_key, last_updated_at])
  @@map("market_driver_canonical_themes")
}

/// Append-only state history for joins, updates, reversals, and confirmations.
model MarketDriverCanonicalThemeRevision {
  id                     String   @id @default(cuid())
  theme_id               String   @db.VarChar(140)
  version                Int
  action                 String   @db.VarChar(30)
  status                 String   @db.VarChar(20)
  summary                String   @db.VarChar(1000)
  geo_state              String?  @db.VarChar(20)
  asset_contributions    Json
  confidence             Float    @default(0)
  reason                 String?  @db.VarChar(1000)
  headline_ids           Json?
  event_ids              Json?
  created_at              DateTime @default(now())
  theme                  MarketDriverCanonicalTheme @relation(fields: [theme_id], references: [id], onDelete: Cascade)

  @@unique([theme_id, version], map: "market_driver_canonical_theme_revision_version_key")
  @@index([theme_id, created_at])
  @@map("market_driver_canonical_theme_revisions")
}

/// Cached AI geopolitical evaluation. The live page reads this cache; it never calls AI.
model GeopoliticalRiskEvaluation {
  id              String   @id @default(cuid())
  day_key         String   @db.VarChar(10)
  theme_fingerprint String @db.Char(64)
  components      Json
  score           Float
  band            String   @db.VarChar(20)
  explanation     String?  @db.VarChar(1000)
  event_count     Int      @default(0)
  provider        String?  @db.VarChar(30)
  model           String?  @db.VarChar(120)
  prompt_version  String?  @db.VarChar(80)
  decision_source String   @default("ai") @db.VarChar(24)
  evaluated_at    DateTime @default(now())
  created_at      DateTime @default(now())

  @@unique([day_key, theme_fingerprint], map: "geo_risk_day_theme_fingerprint_key")
  @@index([day_key, evaluated_at])
  @@map("geopolitical_risk_evaluations")
}

/// Finalized UAE-day snapshot for Historical Analysis (doc §2).
/// Written after the 01:00 Asia/Dubai rollover; live boards always read the current day_key only.
model MarketDriverDayArchive {
  id              String   @id @default(cuid())
  day_key         String   @unique @db.VarChar(10)
  /// Final per-asset catalyst board: [{ asset, bullishCount, bearishCount, driverScore }]
  catalyst_board  Json
  headline_count  Int      @default(0)
  relevant_count  Int      @default(0)
  duplicate_count Int      @default(0)
  irrelevant_count Int     @default(0)
  finalized_at    DateTime @default(now())
  created_at      DateTime @default(now())

  @@map("market_driver_day_archive")
}

/// Versioned, complete session-level AI view. The stored JSON is a replacement snapshot used by
/// Daily Market View and future Fundamental Analysis; historical snapshots remain reusable and
/// never require re-calling AI after rollover.
model MarketDriverSessionSnapshot {
  id                  String   @id @default(cuid())
  day_key             String   @db.VarChar(10)
  source              String   @db.VarChar(40)
  ledger_fingerprint  String   @db.Char(64)
  version             Int
  status              String   @default("VALID") @db.VarChar(20)
  as_of               DateTime
  prompt_version      String   @db.VarChar(80)
  provider            String?  @db.VarChar(30)
  model               String?  @db.VarChar(120)
  snapshot            Json
  catalyst_board      Json
  macro_board         Json
  driver_clusters     Json
  geo_state           Json
  confidence          Float    @default(0)
  needs_review        Boolean  @default(false)
  input_event_count   Int      @default(0)
  input_theme_count   Int      @default(0)
  created_at          DateTime @default(now())

  @@unique([day_key, source, ledger_fingerprint], map: "market_driver_session_snapshot_day_source_fingerprint_key")
  @@unique([day_key, source, version], map: "market_driver_session_snapshot_day_source_version_key")
  @@index([day_key, source, status, version])
  @@index([created_at])
  @@map("market_driver_session_snapshots")
}

/// Durable idempotent lock for one complete Session Brain synthesis per evidence fingerprint.
model MarketDriverSessionSynthesisJob {
  id                 String   @id @default(cuid())
  day_key            String   @db.VarChar(10)
  source             String   @db.VarChar(40)
  ledger_fingerprint String   @db.Char(64)
  idempotency_key    String   @unique @db.VarChar(255)
  ingest_id          String?  @db.VarChar(100)
  status             String   @default("pending") @db.VarChar(20)
  locked_at          DateTime?
  worker_id          String?  @db.VarChar(120)
  snapshot_id        String?  @db.VarChar(50)
  error              String?  @db.VarChar(1000)
  attempt_count      Int      @default(0)
  completed_at       DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([day_key, source, ledger_fingerprint], map: "market_driver_session_job_day_source_fingerprint_key")
  @@index([status, locked_at])
  @@index([day_key, source, created_at])
  @@map("market_driver_session_synthesis_jobs")
}

/// Durable work item for Market Driver classification/recovery. Payloads contain only public RSS
/// headline data and never API keys or prompts. `idempotency_key` prevents duplicate enqueueing
/// when the scraper retries a webhook or a coverage audit overlaps an ingest.
model AiClassificationJob {
  id              String          @id @default(cuid())
  job_type        String          @db.VarChar(40)
  source          String          @db.VarChar(40)
  operation_type  String          @default("classification") @db.VarChar(40)
  content_hash    String?         @db.Char(64)
  idempotency_key String          @unique @db.VarChar(255)
  ingest_id       String?         @db.VarChar(100)
  headline_ids    Json
  payload         Json
  status          String          @default("pending") @db.VarChar(20)
  provider        String?         @db.VarChar(30)
  model           String?         @db.VarChar(120)
  attempt_count   Int             @default(0)
  max_attempts    Int             @default(6)
  next_retry_at   DateTime        @default(now())
  locked_at       DateTime?
  worker_id       String?         @db.VarChar(120)
  last_error_code String?         @db.VarChar(40)
  last_error_kind String?         @db.VarChar(40)
  last_error      String?         @db.VarChar(1000)
  retry_count     Int             @default(0)
  stale_recovery_count Int         @default(0)
  last_retry_at   DateTime?
  last_retry_by   String?         @db.VarChar(120)
  completed_at    DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  usage_records   AiUsageRecord[]

  @@index([status, next_retry_at])
  @@index([status, locked_at])
  @@index([last_error_kind])
  @@index([stale_recovery_count])
  @@index([job_type, created_at])
  @@map("ai_classification_jobs")
}

/// Compact, one-row-per-ingest operational counters. This intentionally stores counters and
/// timing only; RSS payloads and prompts remain in the durable job/provider systems.
model MarketDriverProcessingRun {
  id                        String    @id @default(cuid())
  ingest_id                 String    @unique @db.VarChar(100)
  source                    String    @db.VarChar(80)
  started_at                DateTime
  completed_at              DateTime?
  items_fetched             Int       @default(0)
  new_items                 Int       @default(0)
  existing_items_skipped    Int       @default(0)
  items_enqueued            Int       @default(0)
  items_classified          Int       @default(0)
  exact_duplicates_skipped  Int       @default(0)
  semantic_duplicates_found Int       @default(0)
  failed_items              Int       @default(0)
  recovered_items           Int       @default(0)
  coverage_repairs          Int       @default(0)
  status                    String    @default("processing") @db.VarChar(20)
  error_category            String?   @db.VarChar(40)
  duration_ms               Int?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  @@index([started_at])
  @@index([source, started_at])
  @@index([status, started_at])
  @@map("market_driver_processing_runs")
}

/// One auditable provider attempt. Token fields are nullable because providers do not always
/// return usage on rejected/network failures; null is intentionally different from zero.
model AiUsageRecord {
  id                    String               @id @default(cuid())
  job_id                String?
  ingest_id             String?              @db.VarChar(100)
  operation_type        String               @db.VarChar(40)
  provider              String               @db.VarChar(30)
  model                 String               @db.VarChar(120)
  input_tokens          Int?
  cached_input_tokens   Int?
  output_tokens         Int?
  reasoning_tokens      Int?
  total_tokens          Int?
  usage_available       Boolean              @default(false)
  estimated_input_cost  Decimal?             @db.Decimal(20, 10)
  estimated_cached_cost Decimal?             @db.Decimal(20, 10)
  estimated_output_cost Decimal?             @db.Decimal(20, 10)
  estimated_total_cost  Decimal?             @db.Decimal(20, 10)
  currency              String               @default("USD") @db.Char(3)
  request_status        String               @db.VarChar(20)
  request_id            String?              @db.VarChar(255)
  latency_ms            Int?
  attempt_number        Int                  @default(1)
  is_retry              Boolean              @default(false)
  is_fallback           Boolean              @default(false)
  error_kind            String?              @db.VarChar(40)
  error_message         String?              @db.VarChar(1000)
  created_at            DateTime             @default(now())
  job                   AiClassificationJob? @relation(fields: [job_id], references: [id], onDelete: SetNull)

  @@index([created_at])
  @@index([provider, model, operation_type, created_at])
  @@index([operation_type, created_at])
  @@index([request_status, created_at])
  @@index([job_id])
  @@map("ai_usage_records")
}
